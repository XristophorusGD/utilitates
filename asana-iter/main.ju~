app.on('window-all-closed', async (e)=>
{
	e.preventDefault();
	let webhooksApiInstance = new Asana.WebhooksApi();
	const repoDatorum = await repositorium.utiRepositorio()
	if(repoDatorum !== undefined)
	{
		const arces = await repoDatorum.consequiCongeriem('arx')
		const usuariusMongo = await arces.findOne({signum_usuarii:"trioCivisII"});
		if(usuariusMongo["webhook_ID"])
		{
			try
			{
				webhooksApiInstance.deleteWebhook(usuariusMongo["webhook_ID"]).then((exitus) =>
				{
					console.log("API vocatur, reddit: " + JSON.stringify(exitus.data, null, 2));
					arces.updateOne({signum_usuarii:"trioCivisII"}, {$set: {webhook_ID: undefined}})	
				}, (error) =>
				{
					console.error(error.response.body)
				});
				clearInterval(usuariusMongo['temporisSignum']);
			}
			catch(error)
			{
				console.log("ERROR")
				console.log(error)
			}
		}
	}
	try
	{
		if(repositorium)
		{
			console.log("Mongo Circumscriberi")
			await repositorium.relinquere();
		}
		else
		{
			console.log("Mongo non uteris")
		}
	}
	catch(error)
	{
		console.log(error)
	}
	finally
	{
		if (process.platform !== 'darwin')
		{
			app.quit()
		}
	}

})

